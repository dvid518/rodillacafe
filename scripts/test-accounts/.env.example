# Variables de entorno para scripts de cuentas de prueba (Rodilla)
#
# Copiar este archivo a .env y rellenar los valores reales.
# NUNCA subir .env al repositorio. NUNCA incluir valores reales aquí.

# URL del proyecto Supabase (pública, puede ir en el repositorio)
SUPABASE_URL=https://zmksxwgikagorgyeyhli.supabase.co

# Service Role Key de Supabase (SECRETO - solo para ejecución local)
# Obtenerla en: Panel de Supabase → Settings → API → service_role
# Nunca exponerla en frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
